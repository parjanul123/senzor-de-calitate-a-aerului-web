DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required: PostgreSQL connection URL from Supabase
# For Supabase, include sslmode=require
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require

# ⭐ SUPABASE CONFIGURATION (supabase-py client)
# Project URL - Fixed to your Supabase project
SUPABASE_URL=https://eakzxbfcwbgfxfujzote.supabase.co

# Anon/Public Key - REQUIRED! Get from Supabase Dashboard:
# 1. Go to https://app.supabase.com/project/eakzxbfcwbgfxfujzote/settings/api
# 2. Copy "anon public" key
# 3. Paste below (it's safe, it's public)
SUPABASE_ANON_KEY=sb_publishable_ofI6pPkeb2csAsw_ZqhCng_d3ADhRZU

# JWT JWKS URL (optional, for advanced token verification)
SUPABASE_JWKS_URL=https://eakzxbfcwbgfxfujzote.supabase.co/auth/v1/.well-known/jwks.json